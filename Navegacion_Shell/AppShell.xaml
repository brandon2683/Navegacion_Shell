<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Navegacion_Shell.Views"
       x:Class="Navegacion_Shell.AppShell"
       FlyoutBehavior="Flyout"
       Title="Navegacion_Shell">

    <!-- ====== TABBAR: 3 pestañas ====== -->
    <TabBar>
        <Tab Title="Inicio">
            <ShellContent ContentTemplate="{DataTemplate views:InicioPage}"
                          Route="InicioPage" />
        </Tab>
        <Tab Title="Cursos">
            <ShellContent ContentTemplate="{DataTemplate views:CursosPage}"
                          Route="CursosPage" />
        </Tab>
        <Tab Title="Perfil">
            <ShellContent ContentTemplate="{DataTemplate views:PerfilPage}"
                          Route="PerfilPage" />
        </Tab>
    </TabBar>

    <!-- ====== FLYOUT: Acerca de ====== -->
    <FlyoutItem Title="Acerca de" Route="AcercaDePage">
        <ShellContent ContentTemplate="{DataTemplate views:AcercaDePage}" />
    </FlyoutItem>

    <!-- ====== FLYOUT: Salir ====== -->
    <MenuItem Text="Salir" Clicked="OnSalirClicked" />
</Shell>
