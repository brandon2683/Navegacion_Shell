<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Navegacion_Shell.Models"
             x:Class="Navegacion_Shell.Views.CursosPage"
             Title="Cursos">

    <CollectionView x:Name="CursosCollectionView"
                    SelectionMode="None"
                    Margin="12">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Curso">
                <Frame Margin="0,6" Padding="16" CornerRadius="12"
                       HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Descripcion}" FontSize="13" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Ver"
                                VerticalOptions="Center"
                                Clicked="OnVerCursoClicked"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>