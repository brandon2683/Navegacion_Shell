<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Navegacion_Shell.Views.DetalleCursoPage"
             Title="Detalle del Curso">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="NombreLabel" FontSize="26" FontAttributes="Bold" />
            <Label x:Name="DescripcionLabel" FontSize="16" />
            <Label x:Name="InstructorLabel" FontSize="14" TextColor="Gray" />

            <Button Text="Editar Curso" Clicked="OnEditarClicked" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>